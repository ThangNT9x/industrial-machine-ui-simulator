<Window x:Class="IndustrialMachineSimulator.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:IndustrialMachineSimulator.UI.Controls"
        xmlns:views="clr-namespace:IndustrialMachineSimulator.UI.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="Industrial Machine Simulator"
        Height="1050"
        Width="1920" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Border  BorderBrush="{Binding AlarmFrameBrush}"
        BorderThickness="{Binding AlarmFrameThickness}">
        <Grid>
            <Grid.Resources>
                <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"></BooleanToVisibilityConverter>
            </Grid.Resources>
            <!--Chia hang thanh 4 phan-->
            <Grid.RowDefinitions>
                <RowDefinition Height="38"></RowDefinition>
                <RowDefinition Height="120"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="110"></RowDefinition>
            </Grid.RowDefinitions>
            <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"></ColumnDefinition>
                <ColumnDefinition Width="150"></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <!--Thanh bar menu phai-->
            <controls:RightCommandBar  Grid.Column="1"></controls:RightCommandBar>
           
            <!-- Man hinh giua-->
            <Grid Grid.Row="2"
                  Visibility="{Binding IsHomePage,Converter={StaticResource BoolToVisibilityConverter} }">
                <views:HomeView  ></views:HomeView>
            </Grid>
            <Grid Grid.Row="2" 
                  Visibility="{Binding IsMaintPage,Converter={StaticResource BoolToVisibilityConverter}}">
                 <views:MaintView></views:MaintView>
            </Grid>
            <Grid Grid.Row="2"
                  Visibility="{Binding IsRecipePage,Converter={StaticResource BoolToVisibilityConverter}}">
                 <views:RecipeView></views:RecipeView>
            </Grid>

                <Grid Grid.Row="2"
                      Visibility="{Binding IsDatalogPage,Converter={StaticResource BoolToVisibilityConverter}}">
                    <views:DatalogView></views:DatalogView>
                </Grid>
                <Grid Grid.Row="2"
                      Visibility="{Binding IsSetupPage,Converter={StaticResource BoolToVisibilityConverter}}">
                    <views:SetupView></views:SetupView>
                </Grid>
                <Grid Grid.Row="2"
                      Visibility="{Binding IsAlarmsPage,Converter={StaticResource BoolToVisibilityConverter}}">
                    <views:AlarmsView></views:AlarmsView>
                </Grid>
                <Grid Grid.Row="2"
                      Visibility="{Binding IsListPage,Converter={StaticResource BoolToVisibilityConverter}}">
                    <views:ListView></views:ListView>
                </Grid>
                <Grid Grid.Row="2"
                      Visibility="{Binding IsQuickPage,Converter={StaticResource BoolToVisibilityConverter}}">
                    <views:QuickView></views:QuickView>
                </Grid>
                <Grid Grid.Row="2"
                      Visibility="{Binding IsVisionPage,Converter={StaticResource BoolToVisibilityConverter}}">
                    <views:VisionView></views:VisionView>
                </Grid>
                <Grid Grid.Row="2"
                      Visibility="{Binding IsIoPage,Converter={StaticResource BoolToVisibilityConverter}}">
                    <views:IoView></views:IoView>
                </Grid>
                <Grid Grid.Row="2"
                      Visibility="{Binding IsMESPage,Converter={StaticResource BoolToVisibilityConverter}}">
                    <views:MesView></views:MesView>
                </Grid>
                <Grid Grid.Row="2"
                      Visibility="{Binding IsPowerPage,Converter={StaticResource BoolToVisibilityConverter}}">
                    <views:PowerView></views:PowerView>
                </Grid>

            </Grid>
            <!--Thanh menu bar top-->
            <controls:TopHeaderBar Grid.Row="0"></controls:TopHeaderBar>
            
           <!--Thanh Status Summary Bar-->
            <controls:StatusSummaryBar Grid.Row="1"></controls:StatusSummaryBar>
            
            
            <controls:BottomNavigationBar Grid.Row="3"> </controls:BottomNavigationBar>
            <!-- Overlay power off -->
            <Border Grid.Row="1" Grid.RowSpan="2"  Panel.ZIndex="900" Background="#AA000000">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPowerOffOverlayVisible}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="POWER OFF"
                               FontFamily="Arial"
                               FontSize="42"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Turn on Power Machine from Simulator Control"
                               FontFamily="Arial"
                               FontSize="18"
                               Foreground="White"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
                <Border Grid.Row="0"
                        Grid.RowSpan="4"
                        Background="#DC2626"
                        Height="44"
                        VerticalAlignment="Top"
                        Panel.ZIndex="1100"
                        Visibility="{Binding AlarmBannerVisibility}"
                        IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <TextBlock Text="⚠"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,12,0"/>

                        <TextBlock Text="{Binding AlarmBannerText}"
                           Foreground="White"
                           FontSize="18"
                           FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="0"
                      Grid.RowSpan="4"
                      Visibility="{Binding IsInitializationOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                      Background="#99000000"
                      Panel.ZIndex="1000">

                    <Border Width="540"
                            Height="260"
                            Background="White"
                            CornerRadius="12"
                            BorderBrush="#2563EB"
                            BorderThickness="3"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="28">

                        <StackPanel>
                            <TextBlock Text="INITIALIZATION"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#1D4ED8"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="{Binding InitProgressText}"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,20"/>

                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding InitProgressPercent}"
                                         Height="26"
                                         Margin="0,0,0,18"/>

                            <TextBlock Text="Checking Host / Laser / Diode / Pulsing / Door Safety..."
                                       FontSize="14"
                                       Foreground="#4B5563"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,24"/>

                            <Button Content="Cancel"
                                    Command="{Binding CancelInitializeCommand}"
                                    Width="150"
                                    Height="42"
                                    FontSize="16"
                                    FontWeight="SemiBold"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>





        </Border>
    </Grid>
</Window>