<UserControl x:Class="IndustrialMachineSimulator.UI.Views.DatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="750"
             d:DesignWidth="1750">
    <Grid Background="White" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Operation Log"
                   FontSize="28"
                   FontWeight="Bold"
                   FontFamily="Arial"
                   VerticalAlignment="Center"
                   Margin="10,0,0,0"/>

        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding OperationItems}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time"
                                    Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}"
                                    Width="220"/>
                <DataGridTextColumn Header="Category"
                                    Binding="{Binding Category}"
                                    Width="140"/>
                <DataGridTextColumn Header="Message"
                                    Binding="{Binding Message}"
                                    Width="*"/>
            </DataGrid.Columns>
            
        </DataGrid>
        <Button Grid.Row="1" Content="Clear"
                HorizontalAlignment="Right"
        Width="100"
        Height="36"
        FontSize="16"
        FontFamily="Arial"
        Command="{Binding ClearOperationUiCommand}" />
    </Grid>
</UserControl>