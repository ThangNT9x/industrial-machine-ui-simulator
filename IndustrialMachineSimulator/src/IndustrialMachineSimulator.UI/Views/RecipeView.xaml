<UserControl x:Class="IndustrialMachineSimulator.UI.Views.RecipeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100">

    <Grid Background="#F5F7FA" Margin="12">
        <Grid.Resources>

            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
                <Setter Property="BorderBrush" Value="#D9D9D9"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="LabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Arial"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#333333"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Arial"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#222222"/>
            </Style>

            <Style x:Key="RecipeInputBaseStyle" TargetType="TextBox">
                <Setter Property="Height" Value="36"/>
                <Setter Property="FontFamily" Value="Arial"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="BorderBrush" Value="#BFBFBF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRecipeEditLocked}" Value="True">
                        <Setter Property="Background" Value="#FFF7D6"/>
                        <Setter Property="BorderBrush" Value="#F0C44C"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RecipeNameInputStyle"
                   TargetType="TextBox"
                   BasedOn="{StaticResource RecipeInputBaseStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRecipeNameValid}" Value="False">
                        <Setter Property="Background" Value="#FDECEC"/>
                        <Setter Property="BorderBrush" Value="#D9534F"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ProductModelInputStyle"
                   TargetType="TextBox"
                   BasedOn="{StaticResource RecipeInputBaseStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsProductModelValid}" Value="False">
                        <Setter Property="Background" Value="#FDECEC"/>
                        <Setter Property="BorderBrush" Value="#D9534F"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RecipeCycleIntervalInputStyle"
                   TargetType="TextBox"
                   BasedOn="{StaticResource RecipeInputBaseStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRecipeCycleIntervalValid}" Value="False">
                        <Setter Property="Background" Value="#FDECEC"/>
                        <Setter Property="BorderBrush" Value="#D9534F"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RecipeCycleOkRateInputStyle"
                   TargetType="TextBox"
                   BasedOn="{StaticResource RecipeInputBaseStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRecipeCycleOkRateValid}" Value="False">
                        <Setter Property="Background" Value="#FDECEC"/>
                        <Setter Property="BorderBrush" Value="#D9534F"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="RecipeSorterStepIntervalInputStyle"
                   TargetType="TextBox"
                   BasedOn="{StaticResource RecipeInputBaseStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRecipeSorterStepIntervalValid}" Value="False">
                        <Setter Property="Background" Value="#FDECEC"/>
                        <Setter Property="BorderBrush" Value="#D9534F"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="RecipeInfeedSpacingInputStyle"
                   TargetType="TextBox"
                   BasedOn="{StaticResource RecipeInputBaseStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRecipeInfeedSpacingValid}" Value="False">
                        <Setter Property="Background" Value="#FDECEC"/>
                        <Setter Property="BorderBrush" Value="#D9534F"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SecondaryFooterButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="110"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="FontFamily" Value="Arial"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#333333"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#CFCFCF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,10,0"/>
            </Style>

            <Style x:Key="PrimaryFooterButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="120"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="FontFamily" Value="Arial"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#1677FF"/>
                <Setter Property="BorderBrush" Value="#1677FF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>

        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <StackPanel Grid.Row="0">
                <TextBlock Text="Recipe"
                       FontFamily="Arial"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#222222"/>
                <TextBlock Text="Runtime recipe settings"
                       FontFamily="Arial"
                       FontSize="15"
                       Foreground="#666666"
                       Margin="0,4,0,0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <Border Style="{StaticResource SectionCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Recipe Information"
                                   Style="{StaticResource SectionTitleStyle}"/>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                       Text="Recipe Name"
                                       Style="{StaticResource LabelTextStyle}"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource RecipeNameInputStyle}"
                                     Text="{Binding EditRecipeName, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                       Text="Product Model"
                                       Style="{StaticResource LabelTextStyle}"/>
                                <TextBox Grid.Row="2" Grid.Column="1"
                                     Style="{StaticResource ProductModelInputStyle}"
                                     Text="{Binding EditProductModel, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0"
                                       Text="Cycle Interval (ms)"
                                       Style="{StaticResource LabelTextStyle}"/>
                                <TextBox Grid.Row="4" Grid.Column="1"
                                     Style="{StaticResource RecipeCycleIntervalInputStyle}"
                                     Text="{Binding EditRecipeCycleIntervalMsText, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="6" Grid.Column="0"
                                       Text="Cycle OK Rate"
                                       Style="{StaticResource LabelTextStyle}"/>
                                <TextBox Grid.Row="6" Grid.Column="1"
                                     Style="{StaticResource RecipeCycleOkRateInputStyle}"
                                     Text="{Binding EditRecipeCycleOkRateText, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock Grid.Row="8" Grid.Column="0"
                                       Text="Enable NG Simulation"
                                       Style="{StaticResource LabelTextStyle}"/>
                                <CheckBox Grid.Row="8" Grid.Column="1"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding EditEnableNgSimulation}"/>

                                <TextBlock Grid.Row="10" Grid.Column="0"
                                           Text="Sorter Step Interval (ms)"
                                           Style="{StaticResource LabelTextStyle}"/>
                                <StackPanel Grid.Row="10" Grid.Column="1">
                                    <TextBox Style="{StaticResource RecipeSorterStepIntervalInputStyle}"
                                             Text="{Binding EditRecipeSorterStepIntervalMsText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Time for material to move from one sorter stage to the next. Lower value = faster transport."
                                               FontFamily="Arial"
                                               FontSize="12"
                                               Foreground="#777777"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <TextBlock Grid.Row="12" Grid.Column="0"
                                           Text="Infeed Spacing (ms)"
                                           Style="{StaticResource LabelTextStyle}"/>
                                <StackPanel Grid.Row="12" Grid.Column="1">
                                    <TextBox Style="{StaticResource RecipeInfeedSpacingInputStyle}"
                                             Text="{Binding EditRecipeInfeedSpacingMsText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Delay between loading two new PCB units into the line. Lower value = higher input frequency."
                                               FontFamily="Arial"
                                               FontSize="12"
                                               Foreground="#777777"
                                               Margin="0,4,0,0"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Example: 3000 ms, OK Rate = 0.8"
                                   FontFamily="Arial"
                                   FontSize="13"
                                   Foreground="#777777"
                                   Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                    Padding="14,10"
                    CornerRadius="8"
                    BorderBrush="#D9D9D9"
                    BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#EEF5FF"/>
                            <Setter Property="BorderBrush" Value="#B8D4FF"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRecipeEditLocked}" Value="True">
                                    <Setter Property="Background" Value="#FFF7D6"/>
                                    <Setter Property="BorderBrush" Value="#F0C44C"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasRecipeValidationError}" Value="True">
                                    <Setter Property="Background" Value="#FDECEC"/>
                                    <Setter Property="BorderBrush" Value="#D9534F"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock FontFamily="Arial"
                           FontSize="14"
                           FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#1F5FBF"/>
                                <Setter Property="Text" Value="Ready to apply recipe."/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRecipeEditLocked}" Value="True">
                                        <Setter Property="Foreground" Value="#9A6B00"/>
                                        <Setter Property="Text" Value="Machine is running. Recipe changes are pending, but Apply is disabled."/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasRecipeValidationError}" Value="True">
                                        <Setter Property="Foreground" Value="#B42318"/>
                                        <Setter Property="Text" Value="Invalid recipe values detected. Please check highlighted fields."/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,0,0,0">
                    <Button Content="Reload"
                        Style="{StaticResource SecondaryFooterButtonStyle}"
                        Command="{Binding ReloadRecipeCommand}"/>

                    <Button Content="Cancel"
                        Style="{StaticResource SecondaryFooterButtonStyle}"
                        Command="{Binding CancelRecipeEditCommand}"/>

                    <Button Content="Apply"
                        Style="{StaticResource PrimaryFooterButtonStyle}"
                        Command="{Binding ApplyRecipeCommand}"
                        IsEnabled="{Binding CanApplyRecipe}"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Grid Grid.Column="1">
            <Border Style="{StaticResource SectionCardStyle}" Grid.Column="0" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Recipe List"
                   Style="{StaticResource SectionTitleStyle}"/>

                    <ListBox Grid.Row="2"
                 ItemsSource="{Binding RecipeItems}"
                 SelectedItem="{Binding SelectedRecipeItem}"
                 DisplayMemberPath="RecipeName"
                 FontFamily="Arial"
                 FontSize="15"/>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Load"
                    Width="90"
                    Height="36"
                    Margin="0,0,10,0"
                    Command="{Binding LoadSelectedRecipeCommand}"
                    IsEnabled="{Binding HasSelectedRecipe}"/>

                        <Button Content="Delete"
                    Width="90"
                    Height="36"
                    Command="{Binding DeleteRecipeCommand}"
                    IsEnabled="{Binding CanDeleteRecipe}"/>
                        <Button Content="Save Recipe"
                    Style="{StaticResource SecondaryFooterButtonStyle}"
                    Command="{Binding SaveRecipeCommand}"
                    IsEnabled="{Binding CanSaveRecipe}"/>
                    </StackPanel>
                </Grid>
            </Border>
            
        </Grid>
    </Grid>
    
    
</UserControl>