<UserControl x:Class="IndustrialMachineSimulator.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IndustrialMachineSimulator.UI.Views"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1750">
    <Grid>
        <Grid.Resources>
           
            <!--Set style cho tieu de title panel-->
            <Style x:Key="TittlePanelStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Arial"></Setter>
                <Setter Property="FontSize" Value="25"></Setter>
                <Setter Property="FontWeight" Value="Bold"></Setter>
                <Setter Property="Margin" Value="10,0,0,0"></Setter>
            </Style>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"></ColumnDefinition>
                <ColumnDefinition Width="1.05*"></ColumnDefinition>
                
            </Grid.ColumnDefinitions>


            <!--Man hinh vision ben trai -->
            <Border Grid.Column="0" Padding="10" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" Margin="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"></RowDefinition>
                        <RowDefinition Height="5*"></RowDefinition>
                        <RowDefinition Height="4*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="#D9D9D9" BorderThickness="0,0,0,1">
                        <TextBlock Text="PCB Process" Style="{StaticResource TittlePanelStyle}"></TextBlock>
                    </Border>
                    <Border Grid.Row="1" BorderBrush="#D9D9D9" BorderThickness="0,0,0,1">
                        <Grid >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*"></ColumnDefinition>
                                <ColumnDefinition Width="3*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30"></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Grid.Row="0" Height="25" 
                                 Width="80" TextAlignment="Center" 
                                 HorizontalAlignment="Left" Text="MES Monitor" 
                                 Background="blue" Foreground="White" ></TextBlock>

                        <Border Background="White"
                                BorderBrush="#D9D9D9"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Grid.Column="0" Grid.Row="1"
                                >
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="MES Monitor"
                                               FontSize="22"
                                               FontWeight="Bold"
                                               Foreground="#222222"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <Ellipse Width="12"
                                                 Height="12"
                                                 Fill="{Binding MesStatusDotColor}"
                                                 Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding MesConnectionStatusText}"
                                                   FontSize="14"
                                                   FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="{Binding LastMesTxText}"
                                               FontSize="13"
                                               Foreground="#444444"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding LastMesRxText}"
                                               FontSize="13"
                                               Foreground="#444444"/>
                                </StackPanel>

                                <DataGrid Grid.Row="4"
                                          ItemsSource="{Binding HomeMesItems}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="120"/>
                                        <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="60"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding MessageType}" Width="120"/>
                                        <DataGridTextColumn Header="Payload" Binding="{Binding Payload}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Product Quantity" FontFamily="Arial" 
                                     FontSize="25" Foreground="Black"
                                     FontWeight="Bold" HorizontalAlignment="Center"></TextBlock>
                                <Grid Height="40" Margin="0,20,0,0">
                                    <Label Content="PCB OK" FontSize="25" FontFamily="Arial"
                                     Foreground="Black" HorizontalAlignment="Left" 
                                     VerticalAlignment="Center"
                                     FontWeight="Bold">
                                    </Label>
                                    <Label Content="{Binding PcbOkCount}" Foreground="green" FontFamily="Arial" 
                                    FontSize="25" FontWeight="Bold" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" ></Label>
                                </Grid>
                                <Grid Height="40" Margin="0,20,0,0">
                                    <Label Content="PBA OK" FontSize="25" FontFamily="Arial"
                                     Foreground="Black" HorizontalAlignment="Left" 
                                     VerticalAlignment="Center"
                                     FontWeight="Bold">
                                    </Label>
                                    <Label Content="{Binding PbaOkCount}" Foreground="green" FontFamily="Arial" 
                                    FontSize="25" FontWeight="Bold" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" ></Label>
                                </Grid>
                                <Grid Height="40" Margin="0,20,0,0">
                                    <Label Content="PBA NG" FontSize="25" FontFamily="Arial"
                                     Foreground="Black" HorizontalAlignment="Left" 
                                     VerticalAlignment="Center"
                                     FontWeight="Bold">
                                    </Label>
                                    <Label Content="{Binding PbaNgCount}" Foreground="Red" FontFamily="Arial" 
                                     FontSize="25" FontWeight="Bold" HorizontalAlignment="Right"
                                     VerticalAlignment="Center" ></Label>

                                </Grid>

                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35"></RowDefinition>
                            <RowDefinition></RowDefinition>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="#D9D9D9" BorderThickness="0,0,0,1">
                            <TextBlock Style="{StaticResource TittlePanelStyle}" Text="Mean Time Between Interruptions" ></TextBlock>
                        </Border>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="2*"></ColumnDefinition>
                                <ColumnDefinition Width="*"></ColumnDefinition>
                                <ColumnDefinition Width="2*"></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                                <RowDefinition></RowDefinition>
                            </Grid.RowDefinitions>
                            <Border Grid.Column="0" Grid.RowSpan="4" Background="#99CCFF"></Border>
                            <Border Grid.Column="2" Grid.RowSpan="4" Background="#99CCFF"></Border>
                            <Border Grid.Row="1" Grid.ColumnSpan="4" Height="1" Background="#D9D9D9" VerticalAlignment="top" ></Border>
                            <Border Grid.Row="2" Grid.ColumnSpan="4" Height="1" Background="#D9D9D9" VerticalAlignment="top" ></Border>
                            <Border Grid.Row="3" Grid.ColumnSpan="4" Height="1" Background="#D9D9D9" VerticalAlignment="top" ></Border>
                            <Border Grid.Row="3" Grid.ColumnSpan="4" Height="1" Background="#D9D9D9" VerticalAlignment="Bottom" ></Border>
                            <Border Grid.Column="3" Grid.RowSpan="4" Width="1" Background="#D9D9D9" HorizontalAlignment="Right" ></Border>

                            <TextBlock Grid.Column="0" Grid.Row="0" Text="Recipe Name" FontFamily="Arial" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                            <TextBlock Grid.Column="0" Grid.Row="1" Text="Product Model" FontFamily="Arial" FontSize="20"  HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                            <TextBlock Grid.Column="0" Grid.Row="2" Text="Cycle Interval" FontFamily="Arial" FontSize="20"  HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                            <TextBlock Grid.Column="0" Grid.Row="3" Text="Cycle OK Rate" FontFamily="Arial" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                            <TextBlock Grid.Column="2" Grid.Row="0" Text="Enable Simu" FontFamily="Arial" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                            <TextBlock Grid.Column="2" Grid.Row="1" Text="Run Time" FontFamily="Arial" FontSize="20"  HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                            <TextBlock Grid.Column="2" Grid.Row="2" Text="Cycle Time" FontFamily="Arial" FontSize="20"  HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                            <TextBlock Grid.Column="2" Grid.Row="3" Text="Out Count" FontFamily="Arial" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
                        <Label Grid.Column="1" Grid.Row="0" Content="{Binding CurrentRecipeName}" FontFamily="Arial" FontSize="20" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                        <Label Grid.Column="1" Grid.Row="1" Content="{Binding CurrentProductModel}" FontFamily="Arial" FontSize="20" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                        <Label Grid.Column="1" Grid.Row="2" Content="{Binding CurrentCycleIntervalText}" FontFamily="Arial" FontSize="20" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                        <Label Grid.Column="1" Grid.Row="3" Content="{Binding CurrentCycleOkRateText}" FontFamily="Arial" FontSize="20" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                        <Label Grid.Column="3" Grid.Row="0" Content="{Binding EnableNgSimulation}" FontFamily="Arial" FontSize="20" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                            <Label Grid.Column="3" Grid.Row="1" Content="{Binding RunTimeText}" FontFamily="Arial" FontSize="20" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                            <Label Grid.Column="3" Grid.Row="2" Content="{Binding CycleTimeText}" FontFamily="Arial" FontSize="20" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                            <Label Grid.Column="3" Grid.Row="3" Content="{Binding OutCount}" FontFamily="Arial" FontSize="20" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>

                        </Grid>
                    </Grid>
                </Grid>

            </Border>
          

            <!--Man hinh trang thai co cau may ben phai-->
            <Border Grid.Column="1" Padding="10" Background="White" BorderBrush="#D9D9D9" BorderThickness="1" Margin="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"></RowDefinition>
                        <RowDefinition Height="5*"></RowDefinition>
                        <RowDefinition Height="4*"></RowDefinition>
                    </Grid.RowDefinitions>
                    <!--Tieu de grid ben phai hang1-->
                    <Border Grid.Row="0" BorderBrush="#D9D9D9" BorderThickness="0,0,0,1">
                        <TextBlock Style="{StaticResource TittlePanelStyle}" Text="SORTER"></TextBlock>
                    </Border>
                    <Border Grid.Row="1" BorderBrush="#D9D9D9" BorderThickness="0,0,0,1"></Border>
                    <!--Tiep tuc chia doi man hinh trong man ben phai hang2-->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>
                        <!--Chia man 2.1 thanh 3 cot-->
                        <Grid Grid.Column="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                            <!--Tiep tuc chia nho bang ben trong cot 1-->
                            <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border BorderBrush="#D9D9D9" BorderThickness="1">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Arial" FontSize="20" 
                              Foreground="Black" HorizontalAlignment="Center" 
                              VerticalAlignment="Center"
                              Text="Stage Material"></TextBlock>
                                    <Grid>
                                        <Label Height="25"
                                               Width="30"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left">
                                            <Label.Style>
                                                <Style TargetType="Label">
                                                    <Setter Property="Background" Value="#D8F5B2"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStageMaterialOkLampOn}" Value="True">
                                                            <Setter Property="Background" Value="#99FF00"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Label.Style>
                                        </Label>

                                        <Label Content="OK"
                                               FontFamily="Arial"
                                               FontSize="25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid>
                                        <Label Height="25"
                                               Width="30"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left">
                                            <Label.Style>
                                                <Style TargetType="Label">
                                                    <Setter Property="Background" Value="#F5CACA"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStageMaterialNgLampOn}" Value="True">
                                                            <Setter Property="Background" Value="Red"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Label.Style>
                                        </Label>

                                        <Label Content="NG"
                                               FontFamily="Arial"
                                               FontSize="25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid>
                                            <Label Height="25" Width="30" Background="Blue" VerticalAlignment="Center" HorizontalAlignment="Left"></Label>
                                            <Label Content="XOUT" FontFamily="Arial" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,0,0,0"></Label>
                                        </Grid>
                                        <Grid>
                                            <Label Height="25" Width="30" Background="#FFFF00" VerticalAlignment="Center" HorizontalAlignment="Left"></Label>
                                            <Label Content="IDLE" FontFamily="Arial" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"></Label>
                                        </Grid>

                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!--Man hinh o giua cot 1, chia thanh hinh anh conveyor-->
                            <!-- In/Out Conveyor-->
                            <Grid Grid.Column="1" Margin="5,0,5,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="35"></ColumnDefinition>
                                    <ColumnDefinition Width="15"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="15"></ColumnDefinition>
                                    <ColumnDefinition Width="35"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Border Grid.Column="0" Grid.Row="0"  Margin="5,0,0,5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#7FBF7F"></Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInConveyorRunning}" Value="True">
                                                <Setter Property="Background" Value="Green"></Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                </Border>
                                <Border Grid.Column="0" Grid.Row="1" Margin="5,0,0,5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#7FBF7F"></Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOutConveyorRunning}" Value="True">
                                                <Setter Property="Background" Value="Green"></Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                            </Border>
                                <Border Grid.Column="4" Grid.Row="0" Margin="0,0,5,5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#7FBF7F"></Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInConveyorRunning}" Value="True">
                                                <Setter Property="Background" Value="Green"></Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                            </Border>
                                <Border Grid.Column="4" Grid.Row="1" Margin="0,0,5,5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#7FBF7F"></Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOutConveyorRunning}" Value="True">
                                                <Setter Property="Background" Value="Green"></Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                            </Border>
                                <TextBlock Grid.Column="2" Grid.Row="0"
                                      Text="IN CV"
                                      FontFamily="Arial"
                                      FontSize="10"
                                      Foreground="Black"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"
                                      Margin="0,10,0,0"></TextBlock>
                                <TextBlock Grid.Column="2" Grid.Row="1"
                                      Text="OUT CV"
                                      FontFamily="Arial"
                                      FontSize="10"
                                      Foreground="Black"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Center"
                                      Margin="0,10,0,0"></TextBlock>
                                <TextBlock Grid.Column="1" Grid.Row="0" Height="15" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Background" Value="#F3CACA"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInConveyorSensorOn}" Value="True">
                                                <Setter Property="Background" Value="#FF5A5A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>

                            </TextBlock>
                                <TextBlock Grid.Column="1" Grid.Row="0" Height="15" VerticalAlignment="Bottom">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Background" Value="#F3CACA"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInConveyorSensorOn}" Value="True">
                                                <Setter Property="Background" Value="#FF5A5A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>

                            </TextBlock>
                                <TextBlock Grid.Column="3" Grid.Row="0" Height="15" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Background" Value="#F3CACA"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInConveyorSensorOn}" Value="True">
                                                <Setter Property="Background" Value="#FF5A5A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>

                            </TextBlock>

                                <TextBlock Grid.Column="3" Grid.Row="1" Height="15"  VerticalAlignment="Top" Margin="0,30,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Background" Value="#F3CACA"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOutConveyorSensorOn}" Value="True">
                                                <Setter Property="Background" Value="#FF5A5A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>

                            </TextBlock>
                                <TextBlock Grid.Column="1" Grid.Row="1" Height="15"  VerticalAlignment="Bottom">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Background" Value="#F3CACA"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOutConveyorSensorOn}" Value="True">
                                                <Setter Property="Background" Value="#FF5A5A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>

                            </TextBlock>
                            </Grid>
                            <!-- In/Out Lift-->
                            <Grid Grid.Column="2" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="35"></ColumnDefinition>
                                    <ColumnDefinition Width="35"></ColumnDefinition>
                                    <ColumnDefinition></ColumnDefinition>
                                    <ColumnDefinition Width="15"></ColumnDefinition>
                                    <ColumnDefinition Width="35"></ColumnDefinition>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition></RowDefinition>
                                    <RowDefinition></RowDefinition>
                                </Grid.RowDefinitions>
                                <Border Grid.Column="0" Grid.Row="0"  Margin="5,0,0,5">
                                
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#9FD49F"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInLiftRunning}" Value="True">
                                                    <Setter Property="Background" Value="Green"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                               
                            </Border>
                                <Border Grid.Column="0" Grid.Row="1"  Margin="5,0,0,5">

                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#9FD49F"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOutLiftRunning}" Value="True">
                                                <Setter Property="Background" Value="Green"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                                <Border Grid.Column="4" Grid.Row="0" Margin="0,0,5,5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#9FD49F"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsInLiftRunning}" Value="True">
                                                <Setter Property="Background" Value="Green"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                            </Border>
                            <Border Grid.Column="4" Grid.Row="1" Margin="0,0,5,5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#9FD49F"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOutLiftRunning}" Value="True">
                                                <Setter Property="Background" Value="Green"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                                
                                <TextBlock Grid.Column="2" Grid.Row="0"
                                      Text="IN LIFT"
                                      FontFamily="Arial"
                                      FontSize="10"
                                      Foreground="Black"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Left"
                                      Margin="0,10,0,0"></TextBlock>
                                <TextBlock Grid.Column="2" Grid.Row="1"
                                      Text="OUT LF"
                                      FontFamily="Arial"
                                      FontSize="10"
                                      Foreground="Black"
                                      FontWeight="Bold"
                                      HorizontalAlignment="Left"
                                      Margin="0,10,0,0"></TextBlock>
                                <Label Grid.Column="3" Grid.Row="0" Height="15" Background="#FFCCCC" VerticalAlignment="Top"></Label>
                                <Label Grid.Column="3" Grid.Row="0" Height="15" Background="#FFCCCC" VerticalAlignment="Bottom" Margin="0,0,0,5"></Label>
                                <Label Grid.Column="3" Grid.Row="0" Height="15" Background="#FFCCCC" VerticalAlignment="Bottom" Margin="0,0,0,50"></Label>

                                <Label Grid.Column="3" Grid.Row="1" Height="15" Background="#FFCCCC" VerticalAlignment="Top"></Label>
                                <Label Grid.Column="3" Grid.Row="1" Height="15" Background="#FFCCCC" VerticalAlignment="Bottom" Margin="0,0,0,5"></Label>
                                <Label Grid.Column="3" Grid.Row="1" Height="15" Background="#FFCCCC" VerticalAlignment="Bottom" Margin="0,0,0,50"></Label>
                                <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Vertical" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                    <Label  Height="30" Background="#990000" Content="DW" Foreground="White" FontFamily="Arial" FontSize="15"></Label>
                                    <Label  Height="30" Background="Pink" Content="LD" Foreground="Black" FontFamily="Arial" FontSize="15"></Label>
                                    <Label  Height="30" Background="#990000" Content="UP" Foreground="White" FontFamily="Arial" FontSize="15"></Label>

                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Vertical" VerticalAlignment="Bottom" Margin="0,0,0,5">
                                    <Label  Height="30" Background="#990000" Content="DW" Foreground="White" FontFamily="Arial" FontSize="15"></Label>
                                    <Label  Height="30" Background="Pink" Content="LD" Foreground="Black" FontFamily="Arial" FontSize="15"></Label>
                                    <Label  Height="30" Background="#990000" Content="UP" Foreground="White" FontFamily="Arial" FontSize="15"></Label>

                                </StackPanel>

                            </Grid>
                        </Grid>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition Width="15"></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                                <ColumnDefinition></ColumnDefinition>
                            </Grid.ColumnDefinitions>
                        <Border Grid.Column="2"  Margin="0,50,0,50">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#9FD49F"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNgConveyorRunning}" Value="True">
                                            <Setter Property="Background" Value="Green"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
