<UserControl x:Class="IndustrialMachineSimulator.UI.Views.MesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1200">

    <Grid Background="#F5F7FA" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="MES"
                       FontFamily="Arial"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#222222"/>
            <TextBlock Text="Mock communication panel"
                       FontFamily="Arial"
                       FontSize="15"
                       Foreground="#666666"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="20"
                BorderBrush="#D9D9D9"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Connection"
                           FontFamily="Arial"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#222222"/>

                <TextBlock Text="{Binding MesConnectionStatusText}"
                           FontFamily="Arial"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,12,0,0"/>

                <CheckBox Content="Auto Send Cycle Result"
                          IsChecked="{Binding IsMesAutoSendCycleResult}"
                          Margin="0,12,0,0"/>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Connect"
                            Width="120"
                            Height="38"
                            Margin="0,0,10,0"
                            Command="{Binding ConnectMesCommand}"/>

                    <Button Content="Disconnect"
                            Width="120"
                            Height="38"
                            Margin="0,0,10,0"
                            Command="{Binding DisconnectMesCommand}"/>

                    <Button Content="Clear UI"
                            Width="120"
                            Height="38"
                            Command="{Binding ClearMesUiCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="4"
                  ItemsSource="{Binding MesItems}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  Margin="0,0,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="180"/>
                <DataGridTextColumn Header="Dir" Binding="{Binding Direction}" Width="80"/>
                <DataGridTextColumn Header="Type" Binding="{Binding MessageType}" Width="160"/>
                <DataGridTextColumn Header="Payload" Binding="{Binding Payload}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>