<UserControl x:Class="IndustrialMachineSimulator.UI.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000">
    <Grid Background="#F7F9FC" Margin="12">
        <Grid.Resources>
            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
                <Setter Property="BorderBrush" Value="#D9D9D9"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style x:Key="LabelTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Arial"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="#333333"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="InputTextBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="36"/>
                <Setter Property="FontFamily" Value="Arial"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="BorderBrush" Value="#BFBFBF"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,4,0,0"/>
            </Style>

            <Style x:Key="SaveButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="120"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="FontFamily" Value="Arial"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#1677FF"/>
                <Setter Property="BorderBrush" Value="#1677FF"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.92"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Root" Property="RenderTransform">
                                        <Setter.Value>
                                            <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Setup"
                       FontFamily="Arial"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#222222"/>
            <TextBlock Text="Machine configuration"
                       FontFamily="Arial"
                       FontSize="15"
                       Foreground="#666666"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Content -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Machine Info -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Machine Information"
                                   FontFamily="Arial"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#222222"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="App Title"
                                       Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding EditAppTitle, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="OS Version"
                                       Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding EditOsVersion, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       Text="Laser Time"
                                       Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Grid.Row="4"
                                     Grid.Column="1"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding EditLaserTimeText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- User Password -->
                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="User Password"
                                   FontFamily="Arial"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#222222"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="16"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       Text="Engineer Password"
                                       Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Grid.Row="0"
                                     Grid.Column="1"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding EngineerPasswordValue, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       Text="Developer Password"
                                       Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Grid.Row="2"
                                     Grid.Column="1"
                                     Style="{StaticResource InputTextBoxStyle}"
                                     Text="{Binding DeveloperPasswordValue, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <Button Content="Save"
                    Style="{StaticResource SaveButtonStyle}"
                    Command="{Binding SaveConfigCommand}"/>
        </StackPanel>
    </Grid>
</UserControl>